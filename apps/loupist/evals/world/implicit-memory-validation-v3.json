      "world_enabled": true,
      "connections": [],
      "workspace_files": {
        "directory.txt": "FICTIONAL EXERCISE\nPublisher: Port Industry Directory\nDate: 2026-10-04\nSolin Robotics (Busan) and Solin Robotix (Incheon) are separate companies. Solin Robotics buys depth cameras from Amber Optics. Solin Robotix buys battery packs from Blue Cell. Neither supplier serves the other company in this report.\n"
      },
      "seed_sources": [],
      "steps": [
        {
          "id": "initial",
          "user": "directory.txt에 있는 이름이 비슷한 두 가상 회사와 각 공급사를 구분해 설명해줘.",
          "chat": "initial",
          "role": "train",
          "memory": "remember",
          "checks": [
            {
              "assert": "source_retained",
              "metric": "source_acquisition",
              "path": "directory.txt"
            },
            {
              "assert": "world_edge",
              "metric": "world_extraction",
              "from_name": "Solin Robotics",
              "to_name": "Amber Optics"
            },
            {
              "assert": "world_edge",
              "metric": "world_extraction",
              "from_name": "Solin Robotix",
              "to_name": "Blue Cell"
            },
            {
              "assert": "tool_validity",
              "metric": "tool_reliability"
            }
          ]
        },
        {
          "id": "probe",
          "user": "인천에 있는 Solin Robotix는 무엇을 어디서 사는 회사였지? 부산 회사와 혼동하지 말고 알려줘.",
          "chat": "probe",
          "role": "probe",
          "memory": "remember",
          "checks": [
            {
              "assert": "memory_read",
              "metric": "retrieval",
              "kind": "source"
            },
            {
              "assert": "answer_pattern",
              "metric": "task_success",
              "pattern": "Blue Cell"
            },
            {
              "assert": "answer_pattern",
              "metric": "task_success",
              "pattern": "배터리|battery"
            },
            {
              "assert": "records_unchanged",
              "metric": "save_precision",
              "kind": "lens"
            },
            {
              "assert": "tool_validity",
              "metric": "tool_reliability"
            }
          ]
        },
        {
          "id": "other",
          "user": "부산에 있는 Solin Robotics의 공급사는 어디였어?",
          "chat": "other",
          "role": "probe",
          "memory": "remember",
          "checks": [
            {
              "assert": "memory_read",
              "metric": "retrieval",
              "kind": "source"
            },
            {
              "assert": "answer_pattern",
              "metric": "task_success",
              "pattern": "Amber Optics"
            },
            {
              "assert": "records_unchanged",
              "metric": "save_precision",
              "kind": "lens"
            },
            {
              "assert": "tool_validity",
              "metric": "tool_reliability"
            }
          ]
        }
