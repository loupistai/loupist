{
  "schema": "loupist-world-suite/1",
  "suite": "implicit-memory-validation-v3",
  "version": 1,
  "fixture_delivery": "per_step",
  "description": "Uncued production Chat lifecycle evaluation. User-visible prompts contain no Memory capability hints. Evaluator-only checks measure canonical state and exact tool receipts.",
