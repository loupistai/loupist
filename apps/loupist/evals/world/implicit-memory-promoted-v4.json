{
  "schema": "loupist-world-suite/1",
  "suite": "implicit-memory-promoted-v4",
  "version": 1,
  "fixture_delivery": "per_step",
  "description": "Versioned follow-up: promoted observed failures and separately frozen unseen validation. Only user text reaches Chat.",
  "prompt_policy": "No World/Lens/Memory, save/remember, capability names, tool arguments, or requested output JSON in user prompts. Natural preferences and one-off scope statements are allowed.",
  "scenarios": [
    {
      "id": "V03-UNITS",
      "title": "Comparable units",
      "family": "unit_and_percentage_points",
      "split": "regression",
      "condition": "implicit",
      "world_enabled": true,
      "connections": [],
      "workspace_files": {},
      "seed_sources": [],
      "steps": [
        {
          "id": "learn",
          "user": "나는 실적을 비교할 때 금액 단위를 먼저 맞추고, 영업이익률 변화는 퍼센트포인트로 표시해. 전년 값이 양수일 때만 성장률을 계산하고. 매출 100, 이익 10이면 이익률은?",
          "chat": "learn",
          "role": "train",
          "memory": "remember",
          "checks": [
            {
              "assert": "lens_created",
              "metric": "method_learning"
            },
            {
              "assert": "answer_pattern",
              "metric": "task_success",
              "pattern": "10\\s*%"
            },
            {
              "assert": "tool_validity",
              "metric": "tool_reliability"
            }
          ]
        },
        {
          "id": "document",
          "user": "quartz.txt의 가상 회사 실적을 전년 동기와 비교해줘. 매출 성장률과 이익률 변화를 내 방식으로 설명해줘.",
          "chat": "learn",
          "role": "train",
          "memory": "remember",
          "checks": [
            {
              "assert": "source_retained",
              "metric": "source_acquisition",
              "path": "quartz.txt"
            },
            {
              "assert": "answer_pattern",
              "metric": "task_success",
              "pattern": "25\\s*%"
            },
            {
              "assert": "answer_pattern",
              "metric": "task_success",
              "pattern": "5(?:\\.0+)?\\s*(?:%p|퍼센트포인트|percentage points|pp)"
            },
            {
              "assert": "records_unchanged",
              "metric": "save_precision",
              "kind": "lens"
            },
            {
              "assert": "tool_validity",
              "metric": "tool_reliability"
            }
          ],
          "workspace_files": {
            "quartz.txt": "FICTIONAL EXERCISE\nPublisher: Quartz Tools Exercise Office\nDate: 2026-10-06\nQuartz Tools consolidated revenue in Q3 2025 was KRW 80000 million and operating profit was KRW 8000 million. In Q3 2026 revenue was KRW 100 billion and operating profit was KRW 15 billion. Figures cover matching three-month periods and accounting scope.\n"
          }
        },
        {
          "id": "probe",
          "user": "Quartz Tools의 두 분기 실적에서 매출 성장률과 영업이익률 변화를 다시 정리해줘.",
          "chat": "probe",
          "role": "probe",
          "memory": "remember",
          "checks": [
            {
              "assert": "memory_read",
              "metric": "retrieval",
              "kind": "lens",
              "reference_step": "learn"
            },
            {
              "assert": "memory_read",
              "metric": "retrieval",
              "kind": "source"
            },
            {
              "assert": "answer_pattern",
              "metric": "task_success",
              "pattern": "25\\s*%"
            },
            {
              "assert": "answer_pattern",
              "metric": "task_success",
              "pattern": "5(?:\\.0+)?\\s*(?:%p|퍼센트포인트|percentage points|pp)"
            },
            {
              "assert": "records_unchanged",
              "metric": "save_precision",
              "kind": "lens"
            },
            {
              "assert": "tool_validity",
              "metric": "tool_reliability"
            }
          ]
        }
      ],
      "promoted_from": {
        "suite": "implicit-memory-validation-v3",
        "id": "V03-UNITS"
      }
    },
    {
      "id": "V08-UNICODE",
      "title": "Multilingual original quote",
      "family": "unicode_conversation_provenance",
      "split": "regression",
      "condition": "implicit",
      "world_enabled": false,
      "connections": [],
      "workspace_files": {},
      "seed_sources": [],
      "steps": [
        {
          "id": "original",
          "user": "이번 문장 검토에서만 쓰는 원문은 「café / 東京 / 한글🧩 — 주문번호 Z-é-27」이야. 내가 쓴 원문을 인용하지 말고 접수했다고만 말해줘.",
          "chat": "original",
          "role": "train",
          "memory": "read_only",
          "checks": [
            {
              "assert": "records_unchanged",
              "metric": "save_precision",
              "kind": "all"
            },
            {
              "assert": "tool_validity",
              "metric": "tool_reliability"
            }
          ]
        },
        {
          "id": "aside",
          "user": "문장 내용과 무관하게 9 곱하기 7을 계산해줘.",
          "chat": "original",
          "role": "train",
          "memory": "read_only",
          "checks": [
            {
              "assert": "answer_pattern",
              "metric": "task_success",
              "pattern": "63"
            },
            {
              "assert": "records_unchanged",
              "metric": "save_precision",
              "kind": "all"
            },
            {
              "assert": "tool_validity",
              "metric": "tool_reliability"
            }
          ]
        },
        {
          "id": "probe",
          "user": "Please quote the exact multilingual line I supplied in our earlier discussion, preserving accents, Japanese characters, the emoji, and the order code. Separate my wording from your prior reply.",
          "chat": "probe",
          "role": "probe",
          "memory": "read_only",
          "checks": [
            {
              "assert": "conversation_read",
              "metric": "conversation_provenance",
              "reference_step": "original",
              "complete": true
            },
            {
              "assert": "answer_pattern",
              "metric": "task_success",
              "pattern": "café / 東京 / 한글🧩"
            },
            {
              "assert": "answer_pattern",
              "metric": "task_success",
              "pattern": "Z-é-27"
            },
            {
              "assert": "records_unchanged",
              "metric": "save_precision",
              "kind": "all"
            },
            {
              "assert": "tool_validity",
              "metric": "tool_reliability"
            }
          ]
        }
      ],
      "promoted_from": {
        "suite": "implicit-memory-validation-v3",
        "id": "V08-UNICODE"
      }
    }
  ]
}
