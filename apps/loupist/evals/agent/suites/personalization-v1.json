                    "metric": "carry_forward"
                  }
                ],
                "rubric": [
                  {
                    "id": "source-holdings",
                    "criterion": "The application automatically supplies QFRT and ZQLM as the user's seeded holdings; no separate holdings tool fetch is required. Pass only if the answer establishes ZQLM as an actual holding from the user holdings context, cross-references its 23-day supplier delay in the private bulletin, and distinguishes QFRT as not exposed on the supplied evidence. Merely identifying ZQLM as affected while saying ownership is unknown or cannot be confirmed fails; inventing WISP as a holding also fails.",
                    "metric": "carry_forward"
                  }
                ]
              }
            }
          ]
        }
