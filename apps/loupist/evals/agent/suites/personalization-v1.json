  "scenarios": [
    {
      "id": "U-R01",
      "title": "My holdings uses seeded identities",
      "split": "regression",
      "tags": [
        "en"
      ],
      "connections": [],
      "sessions": [
        {
          "id": "probe",
          "role": "probe",
          "memory": "remember",
          "turns": [
            {
              "user": "What symbols are in my holdings? Do not fetch current prices.",
              "expect": {
                "answer": [
                  {
                    "assert": "contains_any",
                    "values": [
                      "ZQLM"
                    ],
                    "metric": "task_success"
                  },
                  {
                    "assert": "contains_any",
                    "values": [
                      "QFRT"
                    ],
                    "metric": "task_success"
                  }
                ]
              }
            }
          ]
        }
      ],
      "seed": {
        "holdings_csv": "symbol,market,display_name,quantity,cost_basis,market_value,currency\nZQLM,NYSE,Zircon Loom,73,41,3285,USD\nQFRT,NYSE,Quartz Ferry,19,72,1558,USD\n",
        "watchlist": [
          {
            "symbol": "ZQLM",
            "market": "NYSE",
            "display_name": "Zircon Loom"
          },
          {
            "symbol": "QFRT",
            "market": "NYSE",
            "display_name": "Quartz Ferry"
          }
        ]
      }
    },
