{
  "schema": "loupist-agent-suite/1",
  "suite": "session-language",
  "version": 1,
  "description": "Matched Source control, warm research conversations and reciprocal directions under fixed appearances.",
  "scenarios": [
    {
      "id": "LG-003-EN",
      "title": "An English summary of the Alder Rail Source under English appearance",
      "split": "capability",
      "tags": [
        "answer-language",
        "research-session"
      ],
      "language": "en",
      "connections": [],
      "seed": {
        "sources": [
          {
            "title": "Alder Rail quarterly note",
            "origin": "https://fictional.example/alder-rail-q3",
            "text": "Fictional note dated 2026-10-08: Alder Rail carried 18 million passengers in the third quarter of 2026, up from 16 million a year earlier, and its operating margin was 12 percent. Management expects two new trains to arrive in the first half of 2027."
          }
        ]
      },
      "sessions": [
        {
          "id": "research",
          "role": "probe",
          "memory": "read_only",
          "turns": [
            {
              "user": "Summarize the Alder Rail quarterly note in my Sources.",
              "expect": {
                "answer": [
                  {
                    "assert": "answer_language",
                    "language": "en",
                    "metric": "answer_language"
                  },
                  {
                    "assert": "contains_any",
                    "values": [
                      "18",
                      "1,800만",
                      "1800만"
                    ],
                    "metric": "task_success"
                  },
                  {
                    "assert": "cites_source_span",
                    "source_origin": "https://fictional.example/alder-rail-q3",
                    "allow_plain_count": true,
                    "figure_pattern": "(?<![\\d.,−-])(?:18\\s+million\\b|18,?000,?000|1,?800\\s*만)(?:\\s*(?:(?:third[- ]quarter\\s+|Q3\\s+)?(?:passengers?|riders?)\\b|명)|$)",
                    "metric": "retrieval"
                  }
                ],
                "trace": [
                  {
                    "assert": "tool_not_called",
                    "tool": "interface_labels",
                    "metric": "efficiency"
                  }
                ],
                "rubric": [
                  {
                    "id": "alder-ridership",
                    "criterion": "Explain the quarterly note in English and attribute the 18 million third-quarter passengers to Alder Rail and its note. A bare figure, a different quantity or issuer, a refusal, or a paragraph of explanation in another language fails.",
                    "metric": "task_success"
                  }
                ]
              }
            }
          ]
        }
      ],
      "clock": "2026-11-18T09:00:00+09:00"
    },
    {
      "id": "F3-SW-01",
      "title": "Language changes twice in a continuing research session",
      "split": "capability",
      "tags": [
        "answer-language"
      ],
      "language": "ko",
      "clock": "2026-11-18T09:00:00+09:00",
      "connections": [],
      "sessions": [
        {
          "id": "research",
          "role": "probe",
          "memory": "read_only",
          "turns": [
            {
              "user": "Fictional Iris Mill collected 12 million credits in cash from operations and paid 9 million for equipment in June. How much free cash flow did it generate?",
              "expect": {
                "answer": [
                  {
                    "assert": "answer_language",
                    "language": "en",
                    "metric": "answer_language"
                  }
                ],
                "rubric": [
                  {
                    "id": "cash-flow-follow-up",
                    "criterion": "Use the June figures to explain that three million credits remain after equipment spending.",
                    "metric": "task_success"
                  }
                ],
                "trace": [
                  {
                    "assert": "tool_not_called",
                    "tool": "interface_labels",
                    "metric": "efficiency"
                  }
                ]
              }
            },
            {
              "user": "그 설비에 100만 크레디트를 더 썼다면 잉여현금흐름은 어떻게 달라져?",
              "expect": {
                "answer": [
                  {
                    "assert": "answer_language",
                    "language": "ko",
                    "metric": "answer_language"
                  }
                ],
                "rubric": [
                  {
                    "id": "cash-flow-follow-up",
                    "criterion": "Carry forward the same June figures. One million more in equipment spending reduces free cash flow to two million credits.",
                    "metric": "task_success"
                  }
                ],
                "trace": [
                  {
                    "assert": "tool_not_called",
                    "tool": "interface_labels",
                    "metric": "efficiency"
                  }
                ]
              }
            },
            {
              "user": "Why would that change matter to someone looking at how much cash was left?",
              "expect": {
                "answer": [
                  {
                    "assert": "answer_language",
                    "language": "en",
                    "metric": "answer_language"
                  }
                ],
                "rubric": [
                  {
                    "id": "cash-flow-follow-up",
                    "criterion": "Explain that the extra spending leaves less internally generated cash for other uses, referring to the prior example.",
                    "metric": "task_success"
                  }
                ],
                "trace": [
                  {
                    "assert": "tool_not_called",
                    "tool": "interface_labels",
                    "metric": "efficiency"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
