          "role": "probe",
          "memory": "read_only",
          "turns": [
            {
              "user": "保存してある灯台電子の決算短信によると、第2四半期累計の連結営業利益はいくらで、前年同期からどう変わりましたか。",
              "expect": {
                "trace": [
                  {
                    "assert": "progress_language",
                    "language": "ja",
