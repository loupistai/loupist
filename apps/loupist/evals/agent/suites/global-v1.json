                    "metric": "answer_language"
                  }
                ],
                "answer": [
                  {
                    "assert": "answer_language",
                    "language": "ja",
                    "metric": "answer_language"
                  },
                  {
                    "assert": "cites_source_span",
                    "source_origin": "https://fictional.example/global/todai-q2",
                    "figure_pattern": "86\\s*億\\s*5[,，]?000\\s*万|86\\.5\\s*億",
                    "metric": "retrieval"
                  },
                  {
                    "assert": "contains_any",
                    "values": [
                      "12.4"
                    ],
                    "metric": "task_success"
