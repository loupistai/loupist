                    "metric": "retrieval"
                  },
                  {
                    "assert": "no_repeated_failed_call",
                    "metric": "tool_validity"
                  }
                ],
                "answer": [
                  {
                    "assert": "contains_number_any",
                    "values": [
                      "58,000",
                      "58000"
