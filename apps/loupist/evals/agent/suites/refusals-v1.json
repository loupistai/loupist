{
  "schema": "loupist-agent-suite/1",
  "suite": "refusals",
  "version": 1,
  "description": "Six fictional probes that each lead into one host rule: an attachment path, a cached result reference, an asset id without an Asset page, a fact filed without a reference, a rule kept after third-party text, and a check script that asks for changes since the previous run. Each expects the task done another way or an honest account of why not; refusal-evidence.mjs counts the refusals met on the way.",
  "budget": {
    "maxInputTokensPerTurn": 500000,
    "maxTurns": 20
  },
  "scenarios": [
    {
      "id": "P-001",
      "title": "A question about an attached file, which lives outside the workspace folder",
      "split": "capability",
      "language": "en",
      "tags": [
        "refusal-probe",
        "attachment-path"
      ],
      "connections": [],
      "clock": "2026-11-16T10:00:00Z",
      "sessions": [
        {
          "id": "research",
          "role": "probe",
          "memory": "read_only",
          "turns": [
            {
              "user": "I attached our supplier list. Which supplier takes the largest share of spend, and how large is it?",
              "attachments": [
                {
                  "filename": "supplier-list.txt",
                  "media_type": "text/plain",
                  "text": "Harrowfen Pumps supplier spend, fiscal 2026 (share of total purchases)\nCastlebrook Alloys: 31%\nDunmore Seals: 24%\nKelby Motors: 18%\nOther suppliers: 27%\n"
                }
              ],
              "expect": {
                "trace": [
                  {
                    "assert": "no_repeated_failed_call",
                    "metric": "tool_validity"
                  }
                ],
                "answer": [
                  {
                    "assert": "contains_any",
                    "values": [
                      "Castlebrook"
                    ],
                    "metric": "task_success"
                  },
                  {
                    "assert": "contains_number_any",
                    "values": [
                      "31%",
                      "31 percent"
                    ],
                    "metric": "task_success"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "P-002",
      "title": "A calculation over a fetched page, whose cached result Python cannot read by reference",
      "split": "capability",
      "language": "en",
      "tags": [
        "refusal-probe",
        "cached-result-reference",
        "needs-replay",
        "web-research"
      ],
      "connections": [
        "web-research"
      ],
      "clock": "2026-11-16T10:00:00Z",
      "replay": "replay/web-kelby-shipments.json",
      "replay_needs": "web_fetch of https://fictional.example/data/kelby-motors-monthly-shipments-2026 returns a page with Kelby Motors' monthly unit shipments for January to September 2026; July is 12,480, August 13,150 and September 11,970. Searches return nothing and every other request is unmatched.",
      "sessions": [
        {
          "id": "research",
          "role": "probe",
          "memory": "read_only",
          "turns": [
            {
              "user": "Use this page: https://fictional.example/data/kelby-motors-monthly-shipments-2026 and work out with Python the average monthly shipments for July to September 2026. Show the three monthly figures you used.",
              "expect": {
                "trace": [
                  {
                    "assert": "tool_called",
                    "tool": "run_python",
                    "successful": true,
                    "metric": "task_success"
                  },
                  {
                    "assert": "no_repeated_failed_call",
                    "metric": "tool_validity"
                  }
                ],
                "answer": [
                  {
                    "assert": "contains_number_any",
                    "values": [
                      "12,533",
                      "12533",
                      "12,533.3",
                      "12533.3",
                      "12,533.33",
                      "12533.33"
                    ],
                    "metric": "task_success"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
