    {
      "id": "S-003",
      "title": "One-off with offset and fresh conversation",
      "tags": [
        "validation"
      ],
      "split": "regression",
      "connections": [],
      "sessions": [
        {
          "id": "main",
          "role": "probe",
          "memory": "off",
          "turns": [
            {
              "user": "Create a one-time task titled Archive check for January 15, 2027 at 9:30 AM in Seoul. At that time read archive.md in my workspace and summarize unresolved questions. Start with fresh chat history and activate it now. Do not read the file yet.",
              "expect": {
                "trace": [
                  {
                    "assert": "scheduled_tasks",
                    "count": 1,
                    "tasks": [
                      {
                        "title": "Archive check",
                        "status": "active",
                        "target": {
                          "kind": "new_chat"
                        },
                        "schedule": {
                          "kind": "once",
                          "at_ms": 1799973000000
                        },
                        "use_memory": false,
                        "update_memory": false,
                        "prompt_includes": [
                          "archive.md"
                        ],
                        "awaiting_confirmation": false
                      }
                    ],
                    "metric": "task_success"
                  },
                  {
                    "assert": "no_repeated_failed_call",
                    "metric": "tool_validity"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "S-004",
      "title": "Switch session mode without changing the other task",
      "tags": [
        "validation"
      ],
      "split": "regression",
      "connections": [],
      "sessions": [
        {
          "id": "bot",
          "role": "probe",
          "memory": "off",
          "turns": [
            {
              "user": "Create two paused schedules, North review and South review. Each should summarize its matching file north.md or south.md every 120 minutes. Each schedule should continue in its own dedicated conversation. Do not execute the work now.",
              "expect": {
                "trace": [
                  {
                    "assert": "scheduled_tasks",
                    "count": 2,
                    "tasks": [
                      {
                        "title": "North review",
                        "status": "paused",
                        "target": {
                          "kind": "dedicated_chat"
                        },
                        "prompt_includes": [
                          "north.md"
                        ]
                      },
                      {
                        "title": "South review",
                        "status": "paused",
                        "target": {
                          "kind": "dedicated_chat"
                        },
                        "prompt_includes": [
                          "south.md"
                        ]
                      }
                    ],
                    "metric": "task_success"
                  },
                  {
                    "assert": "no_repeated_failed_call",
                    "metric": "tool_validity"
                  }
                ]
              }
            },
            {
              "user": "Change only North review so each run starts with fresh conversation history. Leave it paused and keep South review as it is.",
              "expect": {
                "trace": [
                  {
                    "assert": "scheduled_tasks",
                    "count": 2,
                    "tasks": [
                      {
                        "title": "North review",
                        "status": "paused",
                        "target": {
                          "kind": "new_chat"
                        },
                        "prompt_includes": [
                          "north.md"
                        ]
                      },
                      {
                        "title": "South review",
                        "status": "paused",
                        "target": {
                          "kind": "dedicated_chat"
                        },
                        "prompt_includes": [
                          "south.md"
                        ]
                      }
                    ],
                    "metric": "task_success"
                  },
                  {
                    "assert": "no_repeated_failed_call",
                    "metric": "tool_validity"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
