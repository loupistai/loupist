    {
      "id": "S-007",
      "title": "A session hands an unspecified time to its Bot and the Bot schedules the reply",
      "tags": [
        "validation"
      ],
      "split": "regression",
      "connections": [],
      "sessions": [
        {
          "id": "main",
          "role": "probe",
          "memory": "off",
          "turns": [
            {
              "user": "Please schedule a weekly archive digest of archive.md. I have not decided which day or time yet. Do not read the file now.",
              "expect": {
                "trace": [
                  {
                    "assert": "tool_called",
                    "tool": "schedule_handoff",
                    "metric": "task_success"
                  },
                  {
                    "assert": "scheduled_tasks",
                    "count": 0,
                    "tasks": [],
                    "metric": "task_success"
                  }
                ]
              }
            }
          ]
        },
        {
          "id": "bot",
          "role": "probe",
          "memory": "off",
          "turns": [
            {
              "user": "For the weekly archive digest you asked about, every Monday at 08:00 Asia/Seoul. Please start the schedule.",
              "expect": {
                "trace": [
                  {
                    "assert": "scheduled_tasks",
                    "count": 1,
                    "tasks": [
                      {
                        "status": "active",
                        "prompt_includes": [
                          "archive.md"
                        ],
                        "use_memory": false,
                        "update_memory": false,
                        "awaiting_confirmation": false
                      }
                    ],
                    "metric": "task_success"
                  },
                  {
                    "assert": "no_repeated_failed_call",
