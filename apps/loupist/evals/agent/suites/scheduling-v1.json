{
  "schema": "loupist-agent-suite/1",
  "suite": "scheduling",
  "version": 1,
  "description": "Natural requests for independently saved schedules, task-owned continuing sessions, fresh runs, selective edits and ambiguity restraint. State is graded from SQLite, not save claims.",
