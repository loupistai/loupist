{
  "schema": "loupist-agent-suite/1",
  "suite": "source-search",
  "version": 1,
  "description": "Source retrieval across languages with a similar company in the same collection. Grade discovery, exact read and the cited figure in each answer.",
  "scenarios": [
    {
      "id": "SRC-X01",
      "title": "A Korean question about an English kiln operations note",
      "split": "capability",
      "tags": [
        "cross-language",
        "research-session"
      ],
      "language": "ko",
      "connections": [],
      "seed": {
        "sources": [
          {
            "title": "Mira Tile kiln operations note",
            "origin": "https://fictional.example/src-02",
            "text": "Mira Tile reports: Recovered heat supplied 31% of the roller kiln’s heat demand."
          },
          {
            "title": "Mirae Tile kiln operations note",
            "origin": "https://fictional.example/src-01",
            "text": "Mirae Tile reports: Recovered heat supplied 23% of the tunnel kiln’s heat demand."
          }
        ]
      },
      "sessions": [
        {
          "id": "research",
          "role": "probe",
          "memory": "read_only",
          "turns": [
            {
              "user": "제 자료에서 미래타일은 가마에 필요한 열의 얼마를 폐열로 충당했다고 했나요?",
              "expect": {
                "answer": [
                  {
                    "assert": "answer_language",
                    "language": "ko",
                    "metric": "answer_language"
                  },
                  {
                    "assert": "cites_source_span",
                    "source_origin": "https://fictional.example/src-01",
                    "figure_pattern": "(?<![\\d.,−-])23(?:\\.0+)?\\s*(?:%|％|퍼센트|percent\\b)(?!\\s*(?:p(?:t|oints?)?\\b|포인트|percentile))",
                    "metric": "retrieval"
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
