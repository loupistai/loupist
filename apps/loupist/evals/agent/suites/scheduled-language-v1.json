        "answer-language"
      ],
      "language": "en",
      "clock": "2026-11-18T09:00:00+09:00",
      "connections": [],
      "sessions": [
        {
          "id": "bot",
          "role": "probe",
          "memory": "remember",
          "turns": [
            {
              "user": "Deliver the built-in scheduled briefing.",
              "scheduled": {
                "kind": "briefing"
              },
              "expect": {
                "trace": [
                  {
                    "assert": "scheduled_delivery",
                    "metric": "task_success"
                  }
                ],
                "answer": [
                  {
                    "assert": "answer_language",
                    "language": "en",
                    "metric": "answer_language"
                  }
                ],
                "rubric": [
                  {
                    "id": "empty-briefing",
                    "metric": "task_success",
                    "criterion": "Evaluate the full scheduled reply for content. The scheduled briefing conveys in the appearance language that the empty library has no followed companies or updates to report. Credit an accurate account of what the run could and could not check. Invented holdings, events, or market findings fail."
                  }
                ]
              }
            }
          ]
        }
      ]
