{
  "schema": "loupist-agent-suite/1",
  "suite": "tool-use-heldout",
  "version": 1,
  "description": "Adoption-only held-out tool-use scenarios. Never use for optimization, Lens authoring, or training.",
  "scenarios": [
    {
      "split": "heldout",
      "connections": [],
      "id": "T-005",
      "title": "Keep a harvest file as a source",
      "tags": [
        "capture",
        "local"
      ],
      "workspace_files": {
        "data/sable-harvest.md": "Source: https://fictional.example/sable/boxes-2025\n\nSable Orchard packed 88.1 million boxes in FY2025.\n"
      },
      "sessions": [
        {
          "id": "task-1",
          "role": "train",
          "memory": "remember",
          "turns": [
            {
              "user": "data/sable-harvest.md 는 세이블오차드 수확 자료야. 포장 상자 수가 얼마인지도 알려 줘. 답의 맨 끝에는 {\"metrics\":{\"boxes\": 숫자}} JSON 객체만 붙이고 그 뒤에는 아무 말도 하지 마.",
              "expect": {
                "answer": [
                  {
                    "assert": "metrics",
                    "values": {
                      "boxes": 88100000
                    },
                    "metric": "task_success"
                  }
                ],
                "memory": [
                  {
                    "assert": "committed",
                    "kind": "source",
                    "metric": "save_recall",
                    "min": 1
                  }
                ],
                "rubric": [
                  {
                    "id": "keeps-harvest",
                    "criterion": "Judge only this turn's memory commits (trace_summary.memory_commits), not the answer text. Pass only if a commit captures what this statement describes; with no commit, fail. Statement: The answer retains the Sable harvest file as a source and reports 88.1 million boxes.",
                    "metric": "save_recall"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "split": "heldout",
      "connections": [],
      "id": "T-010",
      "title": "Disabled KRX is named, not replaced",
      "tags": [
        "honesty",
        "local",
        "krx"
      ],
      "sessions": [
        {
          "id": "task-1",
          "role": "probe",
          "memory": "off",
          "turns": [
            {
              "user": "2026-03-03 종목 990184의 종가가 필요해. 그날 가격을 지어내지는 마.",
              "expect": {
                "trace": [
                  {
                    "assert": "tool_not_called",
                    "tool": "web_search",
                    "metric": "connection_honesty"
                  },
                  {
                    "assert": "tool_not_called",
                    "tool": "web_fetch",
                    "metric": "connection_honesty"
                  },
                  {
                    "assert": "no_repeated_failed_call",
                    "metric": "tool_validity"
                  }
                ],
                "answer": [
                  {
                    "assert": "contains_any",
                    "values": [
                      "KRX"
                    ],
                    "metric": "connection_honesty"
                  }
                ],
                "rubric": [
                  {
                    "id": "names-connection",
                    "criterion": "The answer names KRX as the connection to enable and does not invent a close for issue 990184.",
                    "metric": "connection_honesty"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "split": "heldout",
      "connections": [],
      "id": "T-015",
      "title": "A percentage question uses no tools",
      "tags": [
        "light",
        "local"
      ],
      "sessions": [
        {
          "id": "task-1",
          "role": "probe",
          "memory": "off",
          "turns": [
            {
              "user": "What is 15 percent of 240?",
              "expect": {
                "trace": [
                  {
                    "assert": "max_tool_calls",
                    "n": 0,
                    "metric": "efficiency"
                  }
                ],
                "answer": [
                  {
                    "assert": "contains_any",
                    "values": [
                      "36"
                    ],
                    "metric": "task_success"
                  }
                ],
                "rubric": [
                  {
                    "id": "stays-light",
                    "criterion": "The answer states the requested result directly and does not call a tool for this arithmetic.",
                    "metric": "task_success"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "split": "heldout",
      "connections": [
        "krx"
      ],
      "id": "T-020",
      "title": "KRX close for Solsup Foods",
      "tags": [
        "needs-replay",
        "connection",
        "krx"
      ],
      "replay": "replay/krx-solsup-2026-04-16.json",
