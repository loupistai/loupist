{
  "name": "@loupist/desktop",
  "private": true,
  "version": "0.0.1-rc.1",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "vite",
    "preview:capture": "node ./scripts/capture-preview.mjs",
    "preview:layout": "node ./scripts/capture-preview.mjs --chat-layout",
    "preview:diff": "node ./scripts/visual-diff.mjs",
    "preview:baseline": "node ./scripts/visual-baseline.mjs",
    "tauri": "node ./scripts/tauri.mjs",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "check": "sh ./scripts/check.sh",
    "check:harness": "sh ./scripts/check.sh harness",
    "check:python": "sh ./scripts/check.sh python",
    "check:rust": "sh ./scripts/check.sh rust",
    "check:web": "sh ./scripts/check.sh web",
    "check:unused": "knip --config knip.jsonc",
    "lint:hooks": "eslint --max-warnings=0 src",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "sh ./scripts/verify.sh"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.163",
    "@fontsource-variable/geist": "^5.3.0",
    "@klinecharts/extension": "^0.1.0",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "2.12.4",
    "ai": "^7.0.58",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-force": "3.0.0",
    "flint-chart": "^0.5.0",
    "i18next": "26.6.0",
    "katex": "0.19.1",
    "klinecharts": "^10.1.0",
    "lucide-react": "^1.66.0",
    "mdast-util-from-markdown": "2.1.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-force-graph-2d": "1.29.2",
    "react-i18next": "17.1.10",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vega-embed": "^7.3.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/d3-force": "3.0.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "8.72.0",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "^26.1.0",
    "knip": "6.44.1",
    "typescript": "~7.0.2",
    "vite": "^7.1.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "katex": "$katex",
    "@earendil-works/pi-coding-agent": {
      "undici": "8.12.3"
    },
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-codemode": "1.5.0",
    "@earendil-works/pi-mcp": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@earendil-works/pi-telemetry": "1.5.0",
    "minimatch": "11.0.4"
  }
}
