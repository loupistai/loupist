{
  "name": "@loupist/desktop",
  "private": true,
  "version": "0.0.1-rc.1",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite",
    "preview:capture": "node ./scripts/capture-preview.mjs",
    "preview:layout": "node ./scripts/capture-preview.mjs --chat-layout",
    "preview:diff": "node ./scripts/visual-diff.mjs",
    "preview:baseline": "node ./scripts/visual-baseline.mjs",
    "tauri": "node ./scripts/tauri.mjs",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "check": "sh ./scripts/check.sh",
    "check:harness": "sh ./scripts/check.sh harness",
    "check:python": "sh ./scripts/check.sh python",
    "check:rust": "sh ./scripts/check.sh rust",
    "check:web": "sh ./scripts/check.sh web",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "sh ./scripts/verify.sh"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.61",
    "@fontsource-variable/geist": "^5.3.0",
    "@klinecharts/extension": "^0.1.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "2.12.4",
    "ai": "^7.0.58",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-force": "3.0.0",
    "flint-chart": "^0.5.0",
    "i18next": "26.4.4",
    "katex": "0.18.2",
    "klinecharts": "^10.0.0",
    "lucide-react": "^1.30.0",
    "mdast-util-from-markdown": "2.1.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-force-graph-2d": "1.29.1",
    "react-i18next": "17.0.16",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vega-embed": "^7.1.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.1",
    "@earendil-works/pi-coding-agent": "1.0.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-force": "3.0.10",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "katex": "$katex",
    "@earendil-works/pi-coding-agent": {
      "undici": "8.12.3"
    },
    "@earendil-works/chord": "1.0.1",
    "@earendil-works/pi-agent-core": "1.0.1",
    "@earendil-works/pi-ai": "1.0.1",
    "@earendil-works/pi-codemode": "1.0.1",
    "@earendil-works/pi-mcp": "1.0.1",
    "@earendil-works/pi-tui": "1.0.1",
    "@earendil-works/pi-telemetry": "1.0.1",
    "minimatch": "11.0.4"
  }
