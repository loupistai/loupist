{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" != true ] || sh \"$CLAUDE_PROJECT_DIR/scripts/cloud-setup.sh\" --quiet",
            "timeout": 1200
          }
        ]
      }
    ]
  }
}
